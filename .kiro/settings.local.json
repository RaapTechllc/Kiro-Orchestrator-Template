{
  "$schema": "https://kiro.dev/schemas/settings.json",
  "comment": "Conservative Kiro CLI settings for the supported provider-neutral harness. Legacy stop/tool hooks are intentionally disabled.",
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(.kiro/*)",
      "Write(src/*)",
      "Write(tests/*)",
      "Write(PROGRESS.md)",
      "Write(PLAN.md)"
    ],
    "deny": [
      "Write(.git/*)",
      "Write(.env*)",
      "Bash(*)"
    ]
  },
  "agents": {
    "default": "orchestrator",
    "available": [
      "orchestrator",
      "ralph-master",
      "code-surgeon",
      "test-architect",
      "frontend-designer"
    ]
  },
  "environment": {
    "NODE_ENV": "development"
  }
}
